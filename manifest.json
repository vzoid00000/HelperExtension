{
  "manifest_version": 3,
  "name": "OSDP News Helper",
  "version": "0.8.0",
  "description": "Scannt News-Quellen, prüft Relevanz und Datum, übersetzt EN→DE, vergibt Tags nach Handbuch und füllt den OSDP News-Editor – gespeichert wird erst nach deiner Freigabe.",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OSDP News Helper öffnen"
  },
  "options_page": "src/app/app.html",
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": [
        "https://osdp.zentdok.at/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/content/osdp-panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/app/app.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
